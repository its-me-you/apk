##############################################################################
##
##  Gradle start up script for UN*X
##
##############################################################################

# Attempt to set APP_HOME
# Resolve links: $0 may be a symlink
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in
    /* ) app_path=$link ;;
    *) app_path=$APP_HOME$link ;;
    esac
done

APP_HOME=$( cd "${APP_HOME:-.}" && pwd -P ) || exit

APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}
export APP_HOME
export APP_BASE_NAME

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='" "-Xmx64m" "-Xms64m"'

# Use the maximum available, or set MAX_FD != unlimited.
MAX_FD=maximum

warn() {
    echo "$*" >&2
}

die() {
    echo
    echo "$*"
    echo
    exit 1
}

# OS specific support (must be 'true' or 'false').
OS_NAME=$(uname -s | tr '[:upper:]' '[:lower:]')
OS_ARCH=$(uname -m | tr '[:upper:]' '[:lower:]')
case "$OS_NAME" in
  cygwin* )
    OS_NAME=cygwin
    ;;
  msys* )
    OS_NAME=msys
    ;;
  darwin* )
    OS_NAME=darwin
    ;;
esac

case "$OS_NAME$OS_ARCH" in
  osxaarch64 )
    OS_NAME="osx-aarch64"
    ;;
esac

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$msys" ; then
    case $OS_NAME in
    darwin*)
        # See fix for Java7 on macOS #51986
        if [ "$DEFAULT_JVM_OPTS" = "" ] ; then
            DEFAULT_JVM_OPTS='" "-XX:+UseCompressedOops" "-XX:+UseG1GC" "-XX:+UseStringDeduplication" "-XX:+ParallelRefProcEnabled" "-XX:+UnlockDiagnosticVMOptions" "-XX:G1SummarizeRSetStatsPeriod=1"'
        fi
        ;;
    esac
fi

JAVA_OPTS="$( concat_lines "$CLASSPATH" ) $JAVA_OPTS"

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$msys" ; then
    MAX_FD_LIMIT=$( ulimit -H -n ) ||
    MAX_FD_LIMIT=unlimited
    if [ $MAX_FD_LIMIT != unlimited ] ; then
        ulimit -n $MAX_FD_LIMIT
    fi
fi

# Escape application args
save() {
    for i do printf '%s\n' "$i" | sed "s/'/'\\\\''/g;1s/^/'/;\$s/\$/' \\\\ /" ; done
    echo " "
}
APP_ARGS=$( save "$@" )

# Collect all arguments for the java command, stacking in reverse order:
set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

# by default we should be in the correct project dir, but when run from Finder on Mac, the cwd is wrong
if [ "$(uname)" = "Darwin" ] && [ "$HOME" = "$PWD" ] ; then
    cd "$(dirname "$0")/.." || exit 1
fi

exec "$JAVACMD" "$@"